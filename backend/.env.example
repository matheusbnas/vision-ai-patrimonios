# ─── API de Câmeras (Tixxi) ─────────────────────────────────────
API_BASE_URL=http://10.50.3.96:8000
API_KEY=sua_api_key_aqui
API_EMAIL=seu_email@exemplo.com
API_PASSWORD=sua_senha_aqui

# ─── Stream de Vídeo ────────────────────────────────────────────
STREAM_BASE_URL=http://10.50.3.11:5002

# ─── Servidor FastAPI ───────────────────────────────────────────
# DEBUG=true ativa hot-reload (útil dev, mas pode reiniciar com downloads de modelo)
HOST=0.0.0.0
PORT=8001
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── YOLO ───────────────────────────────────────────────────────
# Caminho relativo ao diretório backend/
YOLO_MODEL=../yolo11n.pt
CONFIDENCE_THRESHOLD=0.35

# ─── Hugging Face (opcional) ────────────────────────────────────
# Token só necessário para modelos privados
HF_TOKEN=

# Modelos padrão (públicos)
VANDALISM_MODEL_REPO=KzRyan/Burglary_and_Vandalism
VANDALISM_MODEL_FILE=HYBRID_CNN_TRANSFORMER_MODEL.pth
DAMAGE_MODEL_REPO=dolphinium/damaged-building-detection
